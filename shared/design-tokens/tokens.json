      "1": { "value": "#4F46E5" },
      "2": { "value": "#0EA5E9" },
      "3": { "value": "#10B981" },
      "4": { "value": "#F59E0B" },
      "5": { "value": "#EC4899" },
      "6": { "value": "#8B5CF6" },
      "7": { "value": "#14B8A6" },
      "8": { "value": "#F97316" }
    }
  },
  "font": {
    "family": {
      "base": { "value": "Inter, -apple-system, 'Segoe UI', Roboto, sans-serif" },
      "flutter": { "value": "Inter", "$description": "google_fonts package on Flutter side" }
    },
    "size": {
      "xs": { "value": "12" },
      "sm": { "value": "14" },
      "md": { "value": "16" },
      "lg": { "value": "18" },
      "xl": { "value": "24" },
