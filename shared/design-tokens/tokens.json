{
  "$description": "ControlLeads design tokens — single source of truth for Angular (CSS vars/SCSS via Style Dictionary) and Flutter (ThemeData). Style Dictionary format.",
  "color": {
    "brand": {
      "primary": { "value": "#4F46E5", "$description": "Indigo — primary actions, active nav" },
      "primary-hover": { "value": "#4338CA" },
      "primary-soft": { "value": "#EEF2FF", "$description": "Tinted backgrounds, selected states" },
      "accent": { "value": "#0EA5E9", "$description": "Sky — charts secondary, links" }
    },
