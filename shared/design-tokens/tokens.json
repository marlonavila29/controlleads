    },
    "weight": {
      "regular": { "value": "400" },
      "medium": { "value": "500" },
      "semibold": { "value": "600" },
      "bold": { "value": "700" }
    }
  },
  "space": {
    "$description": "4px base scale",
    "1": { "value": "4" },
    "2": { "value": "8" },
    "3": { "value": "12" },
    "4": { "value": "16" },
    "5": { "value": "24" },
    "6": { "value": "32" },
    "7": { "value": "48" }
